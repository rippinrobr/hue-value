{
	// The Worker that serves the app at huevalue.com.
	"name": "hue-value",
	"compatibility_date": "2026-10-01",
	// Cloudflare runs this before every deploy.
	"build": { "command": "cd app && npm ci && npm run build" },
	"assets": {
		"directory": "./app/dist",
		// Every address without a file gets the app, which draws the right screen.
		"not_found_handling": "single-page-application"
	},
	// Gives each branch and version its own test address. `wrangler preview` needs the
	// previews block, even though it can stay empty.
	"preview_urls": true,
	"previews": {}
}
