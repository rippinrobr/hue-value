{
	"name": "hue-value",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"golden:capture": "node tests/golden/capture.mjs",
		"data:paints": "node scripts/export-paints.mjs",
		"golden:sheet": "node tests/golden/sheet.mjs",
		"test:worker": "node tests/worker/run.mjs",
		"icons": "node scripts/make-icons.mjs",
		"test:offline": "node tests/offline.mjs",
		"test:e2e": "playwright test",
		"test:all": "npm run check && npm run lint && npm test && npm run build && npm run golden:sheet && npm run test:worker && npm run test:offline && npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/pngjs": "^6.0.5",
		"@vite-pwa/sveltekit": "^2.0.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"magicast": "^0.5.5",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^4.1.8",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0"
	}
}
